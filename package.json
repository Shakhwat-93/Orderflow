{
  "name": "orderflow-next",
  "version": "1.0.0",
  "description": "Canvas Order — Enterprise E-Commerce Order Management System",
  "author": "Canvas Order",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:pack": "node scripts/build-desktop.mjs --dir"
  },
  "build": {
    "appId": "com.canvasorder.desktop",
    "productName": "Canvas Order",
    "copyright": "Copyright © 2026 Canvas Order",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "afterPack": "scripts/electron-afterpack.cjs",
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Canvas Order",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "framer-motion": "^13.2.0",
    "ldrs": "^1.1.9",
    "lucide-react": "^0.475.0",
    "motion": "^13.4.4",
    "next": "^15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.0.1",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.5.2",
    "puppeteer-core": "^25.14.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3"
  }
}
